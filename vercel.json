{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix frontend install",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/app/**,backend/pipeline/**,submission/**,data/pack/dev/**,data/pack/corpus/**,data/extra/change_tests_extra.json,data/extra/O*.txt,data/extension/*.json,data/work/audit_log.jsonl,data/work/llm_spend.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}
